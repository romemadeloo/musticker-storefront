# Copy this file to .env and replace the token values before starting Storage.
# PowerShell token generator:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()

ACCESS_TOKEN=replace-with-long-random-bootstrap-token
SECRET=replace-with-long-random-signing-secret
MAIN_BRANCH=production
ALLURE_STORAGE_PORT=3000

# Optional retention. Leave blank to keep reports until manually deleted.
REPORT_RETENTION_MAX_REPORTS_PER_BRANCH=
REPORT_RETENTION_MAX_REPORT_AGE_DAYS=

# Default local filesystem storage in the Docker volume.
STORAGE_BACKEND=fs

# Optional S3-compatible storage. Set STORAGE_BACKEND=s3 and fill these in.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_SESSION_TOKEN=
S3_PREFIX=
S3_REPORTS_PREFIX=
S3_ASSETS_PREFIX=
