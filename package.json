{
  "name": "musticker-storefront-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed:ui": "playwright test --headed --ui",
    "test:e2e:payment": "cross-env RUN_PAYMENT_E2E=true playwright test tests/e2e/payment.spec.ts",
    "test:e2e:list": "playwright test --list",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e:journeys": "playwright test --grep @e2e",
    "test:api": "playwright test --grep @api",
    "test:setup": "playwright test --grep @setup",
    "test:ci": "playwright test --grep-invert @slow",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-playwright": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
