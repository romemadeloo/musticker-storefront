{
  "name": "musticker-storefront-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed:ui": "playwright test --headed --ui",
    "test:e2e:payment": "cross-env RUN_PAYMENT_E2E=true playwright test tests/e2e/purchasing/payment.spec.ts",
    "test:e2e:member-regression": "cross-env RUN_PAYMENT_E2E=true SKIP_SEEDED_AUTH_SETUP=true playwright test tests/e2e/regression/member-purchase-regression.spec.ts",
    "test:e2e:order-all-products": "cross-env RUN_PAYMENT_E2E=true RUN_ORDER_ALL_PRODUCTS_E2E=true SKIP_SEEDED_AUTH_SETUP=true playwright test tests/e2e/purchasing/order-all-products.spec.ts",
    "test:e2e:list": "playwright test --list",
    "test:prod:smoke": "cross-env BASE_URL=https://www.musticker.com/kr RUN_PAYMENT_E2E=false RUN_ORDER_ALL_PRODUCTS_E2E=false SKIP_SEEDED_AUTH_SETUP=true playwright test --grep @smoke --grep-invert \"@payment|@slow|@api|@setup|@destructive\"",
    "test:prod:full": "cross-env BASE_URL=https://www.musticker.com/kr RUN_PAYMENT_E2E=false RUN_ORDER_ALL_PRODUCTS_E2E=false SKIP_SEEDED_AUTH_SETUP=true playwright test --grep-invert \"@payment|@slow|@api|@setup|@destructive\"",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test --grep @auth",
    "test:purchasing": "playwright test --grep @purchasing",
    "test:validation": "playwright test --grep @validation",
    "test:error-handling": "playwright test --grep @error-handling",
    "test:regression": "playwright test --grep @regression",
    "test:e2e:journeys": "playwright test --grep @e2e",
    "test:api": "playwright test --grep @api",
    "test:setup": "playwright test --grep @setup",
    "test:ci": "playwright test --grep-invert @slow",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-playwright": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
